{% extends 'base.html.twig' %}

{% block titre %}Mot de passe oublié · Apprendre{% endblock %}

{% block corps %}

    {{ include('partials/_banniere.html.twig', {
        titre: 'Mot de passe oublié',
        chapo: "Indique l'adresse e-mail de ton compte : nous t'envoyons un lien pour choisir un nouveau mot de passe.",
        ariane: [
            {libelle: 'Apprendre', chemin: path('apprendre_catalogue')},
            {libelle: 'Connexion', chemin: path('apprendre_connexion')},
            {libelle: 'Mot de passe oublié'}
        ]
    }) }}

    <section class="section">
        <div class="conteneur compte-apprenant">
            <form method="post" action="{{ path('apprendre_mot_de_passe_oublie') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('mot-de-passe-oublie') }}">

                <div class="champ">
                    <label class="champ__label" for="email">Adresse e-mail</label>
                    <input type="email" id="email" name="email" class="controle" required autocomplete="email" inputmode="email">
                </div>

                <button type="submit" class="bouton bouton--primaire bouton--large">
                    {{ icone('envoyer', 17) }} Recevoir le lien
                </button>
            </form>

            <p class="compte-apprenant__liens">
                <a href="{{ path('apprendre_connexion') }}">{{ icone('fleche-gauche', 14) }} Retour à la connexion</a>
            </p>
        </div>
    </section>

{% endblock %}
