{# Carte d'un cours du catalogue. Paramètres : cours, bilan (optionnel, si l'apprenant suit le cours). #}
<article class="carte">
    <div class="carte__media">
        {% if cours.imageName %}
            <img src="{{ asset(vich_uploader_asset(cours, 'imageFile')) }}" alt="" loading="lazy">
        {% else %}
            <div class="carte__media-vide" aria-hidden="true">{{ icone('formation', 34) }}</div>
        {% endif %}

        <div class="carte__etiquettes">
            <span class="badge">{{ cours.niveauLibelle }}</span>
            {% if bilan is defined and bilan and bilan.estTermine %}
                <span class="badge badge--succes">Terminé</span>
            {% endif %}
        </div>
    </div>

    <div class="carte__corps">
        <div class="carte__meta">
            <span>{{ icone('horloge', 14) }}{{ cours.dureeMinutes }} min</span>
            <span>{{ icone('livre', 14) }}{{ cours.modules|length }} module{{ cours.modules|length > 1 ? 's' }}</span>
        </div>

        <h3 class="carte__titre">
            <a href="{{ path('apprendre_cours', {slug: cours.slug}) }}">{{ cours.titre }}</a>
        </h3>

        <p class="carte__resume">{{ cours.resume }}</p>

        {% if bilan is defined and bilan %}
            {{ include('apprendre/_progression.html.twig', {bilan: bilan}) }}
        {% endif %}

        <div class="carte__pied">
            <span class="lien-fleche">
                {{ bilan is defined and bilan ? (bilan.estTermine ? 'Revoir le cours' : 'Continuer') : 'Découvrir le cours' }}
            </span>
        </div>
    </div>
</article>
