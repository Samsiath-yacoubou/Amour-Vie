{% extends 'base.html.twig' %}

{% block titre %}Publications{% endblock %}
{% block meta_description %}Ressources et publications d'Amour&Vie ABMS en libre accès.{% endblock %}

{% block corps %}

    {% set filtresActifs = filtres|filter(v => v is not null and v != '')|length %}
    {% set actionFiltres %}
        <button type="button" class="bouton bouton--contour-clair bouton--petit filtres__bouton"
                data-bascule-filtres aria-expanded="false" aria-controls="filtres-corps-publications">
            {{ icone('filtre', 15) }} Filtrer
            {% if filtresActifs > 0 %}<span class="filtres__badge">{{ filtresActifs }}</span>{% endif %}
        </button>
    {% endset %}

    {{ include('partials/_banniere.html.twig', {
        titre: 'Bibliothèque numérique',
        chapo: "Retrouvez les ressources et productions du programme Amour&Vie et de ses partenaires.",
        ariane: [{libelle: 'Publications'}],
        action: actionFiltres
    }) }}

    <section class="section">
        <div class="conteneur">

            <form class="filtres filtres--discret" method="get" action="{{ path('publications') }}" data-filtre-auto
                  aria-labelledby="titre-filtres">
                <h2 id="titre-filtres" class="sr-only">Filtrer les publications</h2>

                <div class="filtres__corps" id="filtres-corps-publications" data-filtres-corps hidden>
                    <div class="filtres__grille">
                        <div class="champ" style="margin:0">
                            <label class="champ__label" for="filtre-q">Rechercher</label>
                            <input type="search" id="filtre-q" name="q" class="controle"
                                   value="{{ filtres.recherche }}" placeholder="Titre ou mot-clé…">
                        </div>

                        <div class="champ" style="margin:0">
                            <label class="champ__label" for="filtre-type">Type de document</label>
                            <select id="filtre-type" name="type" class="controle">
                                <option value="">Tous les types</option>
                                {% for type in types %}
                                    <option value="{{ type.slug }}" {{ filtres.type == type.slug ? 'selected' }}>{{ type.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="champ" style="margin:0">
                            <label class="champ__label" for="filtre-programme">Programme</label>
                            <select id="filtre-programme" name="programme" class="controle">
                                <option value="">Tous les programmes</option>
                                {% for programme in programmes %}
                                    <option value="{{ programme.slug }}" {{ filtres.programme == programme.slug ? 'selected' }}>
                                        {{ programme.sigle }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="champ" style="margin:0">
                            <label class="champ__label" for="filtre-thematique">Thématique</label>
                            <select id="filtre-thematique" name="thematique" class="controle">
                                <option value="">Toutes les thématiques</option>
                                {% for thematique in thematiques %}
                                    <option value="{{ thematique.slug }}" {{ filtres.thematique == thematique.slug ? 'selected' }}>
                                        {{ thematique.nom }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="champ" style="margin:0">
                            <label class="champ__label" for="filtre-annee">Année</label>
                            <select id="filtre-annee" name="annee" class="controle">
                                <option value="">Toutes les années</option>
                                {% for annee in annees %}
                                    <option value="{{ annee }}" {{ filtres.annee == annee ? 'selected' }}>{{ annee }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="filtres__actions">
                        <button type="submit" class="bouton bouton--primaire bouton--petit">
                            {{ icone('filtre', 15) }} Appliquer
                        </button>
                        {% if filtresActifs > 0 %}
                            <a class="bouton bouton--neutre bouton--petit" href="{{ path('publications') }}">Réinitialiser</a>
                        {% endif %}
                    </div>
                </div>
            </form>

            {% if total > 0 %}
                <div class="grille grille--2">
                    {% for publication in publications %}
                        {{ include('partials/_carte_publication.html.twig') }}
                    {% endfor %}
                </div>

                {{ include('partials/_pagination.html.twig', {
                    route: 'publications',
                    parametres: {
                        q: filtres.recherche,
                        type: filtres.type,
                        programme: filtres.programme,
                        thematique: filtres.thematique,
                        annee: filtres.annee
                    }
                }) }}
            {% else %}
                <div class="etat-vide">
                    <div class="etat-vide__icone" aria-hidden="true">{{ icone('livre', 44) }}</div>
                    <h3>Aucun document ne correspond à votre recherche</h3>
                    <p>Essayez d'élargir vos critères ou de consulter l'ensemble de la bibliothèque.</p>
                    <p style="margin-top:1.5rem">
                        <a class="bouton bouton--contour" href="{{ path('publications') }}">Voir toute la bibliothèque</a>
                    </p>
                </div>
            {% endif %}
        </div>
    </section>

{% endblock %}
