{% extends 'base.html.twig' %}

{% block titre %}Émissions radio & TV{% endblock %}
{% block meta_description %}Réécoute et revois les émissions radio et télévision produites par Amour&Vie ABMS.{% endblock %}

{% block corps %}

    {% set filtresActifs = filtres|filter(v => v is not null and v != '')|length %}
    {% set actionFiltres %}
        <button type="button" class="bouton bouton--contour-clair bouton--petit filtres__bouton"
                data-bascule-filtres aria-expanded="false" aria-controls="filtres-corps-emissions">
            {{ icone('filtre', 15) }} Filtrer
            {% if filtresActifs > 0 %}<span class="filtres__badge">{{ filtresActifs }}</span>{% endif %}
        </button>
    {% endset %}

    {{ include('partials/_banniere.html.twig', {
        titre: 'Émissions radio & TV',
        chapo: "Retrouve les émissions radio et télévision portées par les jeunes du programme Amour&Vie.",
        ariane: [{libelle: 'Émissions radio & TV'}],
        action: actionFiltres
    }) }}

    <section class="section">
        <div class="conteneur">

            {# ------------------------------------------------------ Filtres #}
            <form class="filtres" method="get" action="{{ path('emissions') }}" data-filtre-auto
                  aria-labelledby="titre-filtres">
                <h2 id="titre-filtres" class="sr-only">Filtrer les émissions</h2>

                <p class="filtres__resume" role="status">
                    <strong>{{ total }}</strong> émission{{ total > 1 ? 's' : '' }}
                    {% if filtresActifs > 0 %} pour votre sélection{% endif %}
                </p>

                <div class="filtres__corps" id="filtres-corps-emissions" data-filtres-corps hidden>
                    <div class="filtres__grille">
                        <div class="champ" style="margin:0">
                            <label class="champ__label" for="filtre-type">Type</label>
                            <select id="filtre-type" name="type" class="controle">
                                <option value="">Tous les types</option>
                                <option value="radio" {{ filtres.type == 'radio' ? 'selected' }}>Radio</option>
                                <option value="tv" {{ filtres.type == 'tv' ? 'selected' }}>Télévision</option>
                            </select>
                        </div>

                        <div class="champ" style="margin:0">
                            <label class="champ__label" for="filtre-thematique">Thématique</label>
                            <select id="filtre-thematique" name="thematique" class="controle">
                                <option value="">Toutes les thématiques</option>
                                {% for thematique in thematiques %}
                                    <option value="{{ thematique.slug }}" {{ filtres.thematique == thematique.slug ? 'selected' }}>
                                        {{ thematique.nom }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="filtres__actions">
                        <button type="submit" class="bouton bouton--primaire bouton--petit">
                            {{ icone('filtre', 15) }} Appliquer
                        </button>
                        {% if filtresActifs > 0 %}
                            <a class="bouton bouton--neutre bouton--petit" href="{{ path('emissions') }}">Réinitialiser</a>
                        {% endif %}
                    </div>
                </div>
            </form>

            {# ----------------------------------------------------- Résultats #}
            {% if total > 0 %}
                <div class="grille grille--3">
                    {% for emission in emissions %}
                        {{ include('partials/_carte_emission.html.twig') }}
                    {% endfor %}
                </div>

                {{ include('partials/_pagination.html.twig', {
                    route: 'emissions',
                    parametres: {
                        type: filtres.type,
                        thematique: filtres.thematique
                    }
                }) }}
            {% else %}
                <div class="etat-vide">
                    <div class="etat-vide__icone" aria-hidden="true">{{ icone('megaphone', 44) }}</div>
                    <h3>Aucune émission ne correspond à votre recherche</h3>
                    <p>Essayez d'élargir vos critères ou de réinitialiser les filtres.</p>
                    <p style="margin-top:1.5rem">
                        <a class="bouton bouton--contour" href="{{ path('emissions') }}">Voir toutes les émissions</a>
                    </p>
                </div>
            {% endif %}
        </div>
    </section>

{% endblock %}
